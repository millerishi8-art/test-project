# העתק ל-server/.env ומלא ערכים. לא לשמור סודות בקומיט (מוגן ב-.gitignore).

PORT=5000
NODE_ENV=development

JWT_SECRET=

# מנהל ראשי / אימות
ADMIN_EMAIL=
ADMIN_PASSWORD=

# MongoDB Atlas – מחרוזת מלאה מ"Connect" (כלול משתמש וסיסמה)
MONGODB_URI=
# ב-Vercel אפשר להגדיר במקום אחד מהאלה (אותו ערך כמו MONGODB_URI):
# DATABASE_URL=
# MONGO_URI=
# אם Server selection timeout (במיוחד Windows): נסה 1
# MONGODB_FORCE_IPV4=1
# אופציונלי: אם ה-URI ללא שם מסד בנתיב, הקוד משתמש בשם הזה (ברירת מחדל insurance-agent)
MONGODB_DB_NAME=insurance-agent
# לא נדרש אם MONGODB_URI כבר כולל סיסמה (משמש סקריפטים ישנים בלבד)
MONGODB_PASSWORD=

# בסיס כתובת האתר (קישורי אימייל)
APP_BASE_URL=http://localhost:3000

# מייל (Gmail או SMTP)
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=

# Supabase Storage – bucket private-cases (בשרת חובה service_role, לא publishable)
SUPABASE_URL=
# כינוי ל-URL לפריסות שמגדירות רק משתני Next/Vercel; השרת קורא גם את זה
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# כינוי אופציונלי ל-service role
SUPABASE_SECRET_KEY=

# מנהלים (אופציונלי – אם ריק, נטען לפי adminEmails.js)
ADMIN_ALLOWED_EMAILS=
ADMIN_EMAILS=
SUPER_ADMIN_EMAIL=

# CORS נוסף (מופרד בפסיקים)
ALLOWED_ORIGINS=

# Cron / תזכורות
CRON_SECRET=
DISABLE_DEFERRED_REMINDER_CRON=
DEFERRED_PAYMENT_REMINDER_CRON=
CRON_TZ=

# Twilio (אופציונלי)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
