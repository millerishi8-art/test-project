# העתק ל-server/.env ומלא ערכים. לא לשמור סודות בקומיט (מוגן ב-.gitignore).

PORT=5000
NODE_ENV=development

JWT_SECRET=

# מנהל ראשי / אימות
ADMIN_EMAIL=
ADMIN_PASSWORD=

# אימות: supabase = הרשמה/התחברות דרך Supabase Auth (מומלץ עם הנתונים ב-Supabase)
# השאר ריק או local כדי לשמור על JWT+bcrypt+קוד אימייל (legacy)
AUTH_PROVIDER=

# בסיס כתובת האתר (קישורי אימייל)
APP_BASE_URL=http://localhost:3000

# מייל (Gmail או SMTP)
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=

# Supabase Storage – bucket private-cases (בשרת חובה service_role, לא publishable)
SUPABASE_URL=
# השרת מקבל גם את אלה לאותו URL (סדר עדיפות: למעלה → למטה)
NEXT_PUBLIC_SUPABASE_URL=
VITE_SUPABASE_URL=
# מפתח publishable (anon) – נדרש להתחברות signInWithPassword מהשרת וללקוח
SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
VITE_SUPABASE_ANON_KEY=
# חובה לשרת: מפתח service_role (לא publishable/anon) — אחד מהשמות:
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=
SERVICE_ROLE_KEY=

# מנהלים (אופציונלי – אם ריק, נטען לפי adminEmails.js)
ADMIN_ALLOWED_EMAILS=
ADMIN_EMAILS=
SUPER_ADMIN_EMAIL=

# CORS נוסף (מופרד בפסיקים)
ALLOWED_ORIGINS=

# Cron / תזכורות
CRON_SECRET=
DISABLE_DEFERRED_REMINDER_CRON=
DEFERRED_PAYMENT_REMINDER_CRON=
CRON_TZ=

# Twilio (אופציונלי)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
