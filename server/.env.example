# העתק ל-server/.env — לא לשמור סודות בקומיט.

PORT=5000
NODE_ENV=development

JWT_SECRET=

# מנהל מערכת יחיד — אותו מייל לפאנל ניהול (SUPER_ADMIN_EMAIL גובר אם מוגדר)
# ברירת מחדל בקוד: millerbitoach@gmail.com
ADMIN_EMAIL=millerbitoach@gmail.com
SUPER_ADMIN_EMAIL=millerbitoach@gmail.com
ADMIN_PASSWORD=admin123
# מנהלי משנה (מופרד בפסיקים). אם ריק — נטען ברירת מחדל מהקוד (adminEmails.js)
SECONDARY_ADMIN_EMAILS=

# אימות סיסמה דרך Supabase Auth (אופציונלי) — דורש גם SUPABASE_ANON_KEY
AUTH_PROVIDER=

APP_BASE_URL=http://localhost:3000

EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=

# Supabase — חובה לשרת (אותו פרויקט ממסך Settings → API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# נדרש רק אם AUTH_PROVIDER=supabase
SUPABASE_ANON_KEY=

ALLOWED_ORIGINS=

CRON_SECRET=
DISABLE_DEFERRED_REMINDER_CRON=
DEFERRED_PAYMENT_REMINDER_CRON=
CRON_TZ=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
