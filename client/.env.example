# Vite + React (לא Next.js). משתנים לדפדפן: קידומת VITE_ (NEXT_PUBLIC_ לא נטען אוטומטית כאן).
#
# אופציונלי בפרודקשן: כתובת בסיס ל-API (בלי סלאש בסוף). בפיתוח: proxy ל-/api.
# VITE_API_URL=https://your-domain.example.com/api

# גוגל דרייב – בחירת תמונות מהדרייב (אופציונלי)
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# אופציונלי – נדרש לחלק מפעולות Picker:
# VITE_GOOGLE_API_KEY=your-google-api-key
