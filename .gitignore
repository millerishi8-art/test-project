# Dependencies - do not commit (reproducible from package.json + package-lock.json)
node_modules/

# Environment and local data (never commit credentials)
# חשוב: שלילות (!…) חייבות לבוא אחרי כללי ההתעלמות — האחרון שמתאים מנצח.
.env
.env.*
server/.env
!.env.example
!server/.env.example
!client/.env.example
*.log
# Local JSON dumps under server/data (optional). Do not ignore server/data/*.js (e.g. countryCodes.js for casesController).
server/data/*.json

# Build output
dist/
build/
.vite/

# OS and editor
.DS_Store
Thumbs.db
*.swp
*.swo
.vercel
